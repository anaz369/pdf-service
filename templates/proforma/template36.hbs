<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PROFORMA INVOICE - {{basicdetails.[0].inv_no}}</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: ibmplexsansarabic, Arial, Helvetica, sans-serif;
    font-size: 11px;
    color: #212529;
    background: #fff;
    line-height: 1.4;
    margin: 0 6mm;
  }
  .page { width: 100%; padding-top: 6px; }

  table { border-collapse: collapse; width: 100%; }

  /* ── Title ─────────────────────────────────── */
  .doc-title {
    text-align: center;
    font-size: 18.5px;
    font-weight: bold;
    color: #504d73;
    padding: 2px 0 8px;
  }

  /* ── Details grid ──────────────────────────── */
  .details { table-layout: fixed; }
  .details td {
    border: 1px solid #000;
    padding: 4px 6px;
    vertical-align: middle;
    text-align: center;
    font-size: 11px;
  }
  .details .lbl    { background: #c6e1f2; }
  .details .lbl-ar { background: #c6e1f2; direction: rtl; }
  .details .val    { background: #fff; }
  /* white channel that splits the customer block from the document block —
     no borders of its own, so the two grids read as separate tables */
  .details .gap {
    background: #fff;
    border-top: none;
    border-bottom: none;
    border-left: none;
    border-right: none;
    padding: 0;
  }

  /* ── Items table ───────────────────────────── */
  .items { table-layout: fixed; margin-top: 5px; }
  .items th, .items td { border: 1px solid #000; padding: 4px; }
  /* reprint the column headings at the top of every page the table spans */
  .items thead { display: table-header-group; }
  .items thead th {
    background: #504d73;
    color: #fff;
    font-weight: bold;
    text-align: center;
    font-size: 11px;
    line-height: 1.4;
  }
  .items thead .r-ar th { direction: rtl; }
  .items thead th.idx { vertical-align: middle; }
  /* a tall bilingual row sliced by a page break loses the clipped half —
     move the whole row to the next page instead */
  .items tbody tr { page-break-inside: avoid; break-inside: avoid; }
  .items tbody td { text-align: center; vertical-align: middle; font-size: 11px; line-height: 1.2; }
  .items tbody td.desc .ar { direction: rtl; }

  /* ── Totals ────────────────────────────────── */
  .totals { table-layout: fixed; margin-top: 5px; }
  .totals td { border: 1px solid #000; padding: 4px 8px; font-size: 12px; line-height: 1.3; }
  .totals .t-blank  { background: #fff;border:none; }
  .totals .t-lbl    { background: #504d73; color: #fff; font-weight: bold; text-align: left; }
  /* the Arabic caption fills its cell edge to edge in the reference layout —
     tight padding keeps it on one line instead of wrapping and doubling the row */
  .totals .t-lbl-ar {
    background: #504d73; color: #fff; font-weight: bold;
    direction: rtl; text-align: right;
    padding: 4px 4px; white-space: nowrap;
  }
  .totals .t-val    { background: #fff; text-align: right; font-weight: bold; }
  .totals .words    { background: #fff; text-align: center; font-weight: bold; padding: 2px 8px; }

  /* ── Bank details ──────────────────────────── */
  .bank { table-layout: fixed; margin-top: 11px; }
  .bank td {
    border: 1px solid #000;
    padding: 2px 6px;
    text-align: center;
    vertical-align: middle;
    font-size: 11px;
    line-height: 1.2;
  }
  .bank .hd     { background: #504d73; color: #fff; font-weight: bold; font-size: 12px; padding: 4px 6px; line-height: 1.3; }
  .bank .lbl    { background: #c6e1f2; padding: 4px 6px; }
  .bank .lbl-ar { background: #c6e1f2; padding: 4px 6px; direction: rtl; }

  /* keep totals + bank block whole — never split across a page */
  .footer-block { page-break-inside: avoid; break-inside: avoid; }
</style>
</head>
<body>
<div class="page">

  {{!-- ══ TITLE ══ --}}
  <div class="doc-title">PROFORMA INVOICE / الفاتورة الأولية</div>

  {{!-- ══ DETAILS GRID ══ --}}
  {{!-- one table, two visual blocks: customer (left) and document (right),
        separated by the borderless .gap column --}}
  <table class="details">
    <colgroup>
      <col style="width:13%">
      <col style="width:36%">
      <col style="width:10%">
      <col style="width:1%">
      <col style="width:10%">
      <col style="width:20%">
      <col style="width:11%">
    </colgroup>
    <tr>
      <td class="lbl" rowspan="2">Customer Name</td>
      <td class="val" rowspan="2">{{billing_address.[0].name}}{{#if billing_address_lang2.[0].name}}<br>{{billing_address_lang2.[0].name}}{{/if}}</td>
      <td class="lbl-ar" rowspan="2">اسم العميل</td>
      <td class="gap" rowspan="6"></td>
      <td class="lbl">Doc No</td>
      <td class="val">{{basicdetails.[0].inv_no}}</td>
      <td class="lbl-ar">رقم</td>
    </tr>
    <tr>
      <td class="lbl">Doc Date</td>
      <td class="val">{{basicdetails.[0].inv_date}}</td>
      <td class="lbl-ar">تاريخ</td>
    </tr>
    <tr>
      <td class="lbl">Customer's Address</td>
      <td class="val">{{billing_address.[0].address_line1}}  {{billing_address.[0].address_line2}}  {{billing_address.[0].address_line4}}  {{billing_address.[0].address_line3}}  {{billing_address.[0].address_line5}}  {{billing_address_lang2.[0].address_line1}}  {{billing_address_lang2.[0].address_line2}}  {{billing_address_lang2.[0].address_line4}}  {{billing_address_lang2.[0].address_line3}}  {{billing_address_lang2.[0].address_line5}}{{#if billing_address.[0].address_code}}<br><br>ZIP/Postal Code: {{billing_address.[0].address_code}}{{/if}}</td>
      <td class="lbl-ar">عنوان العميل</td>
      <td class="lbl">Due Date</td>
      <td class="val">{{basicdetails.[0].due_date}}</td>
      <td class="lbl-ar">تاريخ الاستحقاق</td>
    </tr>
    <tr>
      <td class="lbl">Payment Terms</td>
      <td class="val">{{basicdetails.[0].payment_terms}}</td>
      <td class="lbl-ar">شروط الدفع</td>
      <td class="lbl">Our Ref</td>
      <td class="val">{{basicdetails.[0].reference_no}}</td>
      <td class="lbl-ar">رقم المرجعي</td>
    </tr>
    <tr>
      <td class="lbl">VAT NO</td>
      <td class="val">{{billing_address.[0].vat}}</td>
      <td class="lbl-ar">الرقم الضريبة</td>
      <td class="lbl">PO Number</td>
      <td class="val">{{basicdetails.[0].order_no}}</td>
      <td class="lbl-ar">طلب الشراء</td>
    </tr>
    <tr>
      <td class="lbl">CR NO</td>
      <td class="val">{{customer_details.[0].cr_no}}</td>
      <td class="lbl-ar">سجل تجاري</td>
      <td class="lbl">SalesPerson</td>
      <td class="val">{{basicdetails.[0].salesman_name}}</td>
      <td class="lbl-ar">مندوب المبيعات</td>
    </tr>
  </table>

  {{!-- ══ ITEMS ══ --}}
  <table class="items">
    <colgroup>
      <col style="width:3%">
      <col style="width:33%">
      <col style="width:7%">
      <col style="width:7%">
      <col style="width:10%">
      <col style="width:12%">
      <col style="width:11%">
      <col style="width:16%">
    </colgroup>
    <thead>
      <tr class="r-en">
        <th><span>م</span><br>#</th>
        <th><span>الاسم والوصف</span><br>Item &amp; Description </th>
        <th><span>الكمية</span><br>Qty</th>
        <th><span>الوحدة</span><br>Unit</th>
        <th><span>سعرالوحدة</span><br>Price</th>
        <th><span>المبلغ بدون ضريبة</span><br>Without VAT</th>
        <th><span>قيمة الضريبة</span><br>VAT Amount</th>
        <th><span>المجموع شامل الضريبة</span><br>Total inc. VAT</th>
      </tr>
    </thead>
    <tbody>
      {{#each itemdetails}}
      <tr>
        <td>{{addOne @index}}</td>
        <td class="desc">
          {{item_name}}
          {{#if name_lang2}}<div class="ar">{{name_lang2}}</div>{{/if}}
          {{#if description}}<div>{{description}}</div>{{/if}}
        </td>
        <td>{{quantity}}</td>
        <td>{{unit}}</td>
        <td>{{formatAmount price ../bcdp}}</td>
        <td>{{formatAmount taxable ../bcdp}}</td>
        <td>{{formatAmount vat_amt ../bcdp}}</td>
        <td>{{formatAmount amount ../bcdp}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="footer-block">

  {{!-- ══ TOTALS ══ --}}
  <table class="totals">
    <colgroup>
      <col style="width:30%">
      <col style="width:30%">
      <col style="width:24">
      <col style="width:16%">
    </colgroup>
    <tr>
      <td class="t-blank" rowspan="5"></td>
      <td class="t-lbl">Total Without VAT</td>
      <td class="t-lbl-ar">الاجمالي بدون ضريبة</td>
      <td class="t-val">{{formatAmount (divide basicdetails.[0].subtotal ccrate) bcdp}}</td>
    </tr>
    {{#if zatcadiscount.[0]}}
        {{#each zatcadiscount}}
          <tr>
            <td class="t-lbl">{{reason_name}}</td>
            <td class="t-lbl-ar">الخصومات</td>
            <td class="t-val">{{formatAmount (divide dld ../ccrate) ../bcdp}}</td>
          </tr>
        {{/each}}
    {{else}}

        {{#if (or basicdetails.[0].discount basicdetails.[0].dld)}}
        <tr>
          <td class="t-lbl">Discount</td>
          <td class="t-lbl-ar">الخصومات</td>
          <td class="t-val">{{formatAmount (divide (add basicdetails.[0].discount basicdetails.[0].dld) ccrate) bcdp}}</td>
        </tr>
        {{/if}}

    {{/if}}
    <tr>
      <td class="t-lbl">VAT Total {{itemdetails.[0].vat_perc}}%</td>
      <td class="t-lbl-ar">ضريبة القيمة المضافة</td>
      <td class="t-val">{{formatAmount (divide basicdetails.[0].vatamt ccrate) bcdp}}</td>
    </tr>
    <tr>
      <td class="t-lbl">Total With VAT in {{basicdetails.[0].base_country_isocode}}</td>
      <td class="t-lbl-ar">المجموع شامل الضريبه</td>
      <td class="t-val">{{formatAmount (divide basicdetails.[0].grand_total ccrate) bcdp}}</td>
    </tr>
    <tr>
      <td class="words" colspan="3">المبلغ كتابه بريال السعودي : {{bcamountinwordsar}}</td>
    </tr>
  </table>

  {{!-- ══ BANK DETAILS ══ --}}
  <table class="bank">
    <colgroup>
      <col style="width:29.3%">
      <col style="width:48.1%">
      <col style="width:22.6%">
    </colgroup>
    <tr>
      <td class="hd" colspan="3">Bank Account Details | تفاصيل الحساب البنكي</td>
    </tr>
    <tr>
      <td class="lbl">Account Name</td>
      <td>{{bankdetails.acc_name}}</td>
      <td class="lbl-ar">إسم الحساب</td>
    </tr>
    <tr>
      <td class="lbl">Bank Name</td>
      <td>{{bankdetails.name}}</td>
      <td class="lbl-ar">اسم البنك</td>
    </tr>
    <tr>
      <td class="lbl">Account Number</td>
      <td>{{bankdetails.acc_no}}</td>
      <td class="lbl-ar">رقم حساب</td>
    </tr>
    <tr>
      <td class="lbl">IBAN No</td>
      <td>{{bankdetails.iban_no}}</td>
      <td class="lbl-ar">رقم الآيبان</td>
    </tr>
  </table>

  </div>

</div>
</body>
</html>
