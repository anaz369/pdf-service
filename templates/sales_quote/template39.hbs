<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quotation - {{basicdetails.[0].inv_no}}</title>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #ffffff;
    font-family: ibmplexsansarabic;
    font-size: 11px;
    color: #222;
    line-height: 1.45;
    margin: 0 8mm;
  }

  .page { width: 100%; margin: 0 auto; padding-top: 6px; }

  /* ── Title ─────────────────────────────────── */
  .main-title {
    text-align: center;
    font-size: 16px;
    font-weight: bold;
    color: #000000;
    padding: 4px 0 12px;
  }
  .main-title .ar { direction: rtl; }

  /* ── Top info (two-part layout) ───────────── */
  .top-info-wrap {
    width: 100%;
    margin-bottom: 4px;
  }
  .info-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    text-align: left;
  }
  .info-table td {
    border: 1px solid #bfbfbf;
    padding: 4px 8px;
    font-size: 11px;
    vertical-align: top;
  }
  .info-table .info-left {
    vertical-align: top;
    padding: 0;
  }
  .left-detail-table {
    width: 100%;
    border-collapse: collapse;
  }
  .left-detail-table td {
    border: none;
    padding: 6px 10px;
    font-size: 11px;
    vertical-align: top;
  }
  .left-detail-table .ld-lbl {
    font-weight: 700;
    white-space: nowrap;
  }
  .left-detail-table .ld-val {
    font-weight: normal;
  }
  .info-table .right-lbl {
    {{!-- font-weight: 700; --}}
    text-align: center;
  }
  .info-table .right-val {
    text-align: center;
  }
  .info-table .right-ar {
    direction: rtl;
    {{!-- font-weight: 700; --}}
    text-align: center;
    font-size: 11px;
  }

  /* ── Items table ───────────────────────────── */
  .items-wrap {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-top: 4px;
    border: 1px solid #bfbfbf;
    border-bottom:none;
  }
  .items-wrap th {
    font-size: 11px;
    vertical-align: top;
    padding: 2px 6px;
  }
  .items-wrap td {
    font-size: 10px;
    vertical-align: middle;
    padding: 2px 6px;
  }
  .items-wrap td {
    border: 1px solid #bfbfbf;
    border-top: none;
  }
  .items-wrap thead th {
    text-align: center;
    font-weight: normal;
    background: #cccccc;
    padding: 2px 6px;
    border: 1px solid #bfbfbf;
  }
  .items-wrap .head-ar {
    direction: rtl;
    font-size: 11px;
    display: block;
  }
  .items-wrap .head-en {
    display: block;
    font-weight: bold;
  }
  .items-wrap .center { text-align: center; }
  .items-wrap .right  { text-align: right; }
  .items-wrap .left   { text-align: left; }

  /* The gap under the last item is whatever the page break leaves, not a fixed
     280px block: a short quote used to carry a large hole, and a long one had
     the spacer shoved onto a page of its own. The row stays so the column rules
     carry on below the last item. */
  .item-spacer td {
    height: 0;
    border-top: none;
    border-bottom: none;
  }

  /* ── FOOTER BLOCK : kept together, pushed to next page if needed ── */
  .footer-block {
    overflow: hidden;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  /* keep an item row whole rather than sliced by a page break */
  .items-wrap tbody tr:not(.item-spacer) {
    page-break-inside: avoid;
    break-inside: avoid;
  }
  /* reprint the column headings atop every page the table spans */
  .items-wrap thead { display: table-header-group; }

  /* ── Totals ───────────────────────────────── */
  .totals-wrap {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    border: 1px solid #bfbfbf;
    border-top: none;
  }
  .totals-wrap td {
    border: 1px solid #bfbfbf;
    padding: 4px 10px;
    font-size: 11px;
  }
  .totals-wrap .t-lbl {
    text-align: center;
    font-weight: bold;
  }
  .totals-wrap .t-ar {
    direction: rtl;
    text-align: right;
  }
  .totals-wrap .t-val {
    text-align: right;
    font-weight: bold;
  }
  .totals-wrap .t-blank { border: none; }

  /* ── Words row ────────────────────────────── */
  .words-wrap {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    border: 1px solid #bfbfbf;
    margin-top: 4px;
  }
  .words-wrap td {
    padding: 4px 10px;
    font-size: 11px;
  }

  /* ── Bottom section ───────────────────────── */
  .bottom-wrap {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-top: 4px;
  }
  .bottom-wrap > tbody > tr > td {
    border: 1px solid #bfbfbf;
    padding: 6px 10px;
    vertical-align: top;
    font-size: 11px;
  }

  .terms-title {
    background: #d9d9d9;
    padding: 6px 8px;
    font-weight: bold;
    border-bottom: 1px solid #bfbfbf;
    margin: -8px -10px 6px;
  }
  .terms-text { margin-top: 4px; }

  .bank-block { padding: 0; }
  .bank-head {
    background: #d9d9d9;
    padding: 6px 8px;
    font-weight: bold;
    border-bottom: 1px solid #bfbfbf;
    margin: -8px -10px 6px;
  }
  .bank-detail-table {
    width: 100%;
    border-collapse: collapse;
  }
  .bank-detail-table td {
    border: none;
    padding: 2px 0;
    font-size: 11px;
    vertical-align: top;
  }
  .bank-detail-table .bd-lbl {white-space: nowrap; }
  .bank-detail-table .bd-sep {padding: 2px 6px; }
</style>
</head>
<body>

<div class="page">

  <!-- Title -->
  <div class="main-title">
    Quotation / <span class="ar">عرض السعر</span>
  </div>

  <!-- Top Info Table -->
  <div class="top-info-wrap">
    <table class="info-table">
      <colgroup>
        <col style="width:47%">
        <col style="width:16%">
        <col style="width:22%">
        <col style="width:15%">
      </colgroup>
      <tr>
        <td class="info-left" rowspan="4">
          <table class="left-detail-table">
            <colgroup>
              <col style="width:24%">
              <col style="width:2%">
              <col style="width:74%">
            </colgroup>
            <tr>
              <td class="ld-lbl">Customer Name</td>
               <td class="ld-lbl">:</td>
              <td class="ld-val">{{billing_address.[0].name}}</td>
            </tr>
            <tr>
              <td class="ld-lbl">Address</td>
              <td class="ld-lbl">:</td>
              <td class="ld-val">{{#if billing_address.[0].address_line1}}{{billing_address.[0].address_line1}}{{/if}}{{#if billing_address.[0].address_line2}}, {{billing_address.[0].address_line2}}{{/if}}{{#if billing_address.[0].address_line3}}, {{billing_address.[0].address_line3}}{{/if}}{{#if billing_address.[0].address_line4}}, {{billing_address.[0].address_line4}}{{/if}}{{#if billing_address.[0].address_code}}, {{billing_address.[0].address_code}}{{/if}}{{#if billing_address.[0].address_line5}}, {{billing_address.[0].address_line5}}{{/if}}</td>
            </tr>
            <tr>
              <td class="ld-lbl">VAT</td>
              <td class="ld-lbl">:</td>
              <td class="ld-val">{{billing_address.[0].vat}}</td>
            </tr>
          </table>
        </td>
        <td class="right-lbl">Quotation No</td>
        <td class="right-val">{{basicdetails.[0].inv_no}}</td>
        <td class="right-ar">رقم عرض السعر</td>
      </tr>
      <tr>
        <td class="right-lbl">Issue Date</td>
        <td class="right-val">{{basicdetails.[0].inv_date}}</td>
        <td class="right-ar">تاريخ الإصدار</td>
      </tr>
      <tr>
        <td class="right-lbl">Expiry Date</td>
        <td class="right-val">{{basicdetails.[0].due_date}}</td>
        <td class="right-ar">تاريخ الانتهاء</td>
      </tr>
      <tr>
        <td class="right-lbl">Contact Person</td>
        <td class="right-val">{{basicdetails.[0].custprofilecontactname}}</td>
        <td class="right-ar">الشخص المسؤول</td>
      </tr>
    </table>
  </div>

  <!-- Items Table -->
  <table class="items-wrap">
    {{!-- the Item Code column only exists when at least one line has a code;
         its 12% goes to Description when it is dropped --}}
    <colgroup>
      <col style="width:4%">
      {{#hasItemCode itemdetails}}<col style="width:13%">{{/hasItemCode}}
      <col style="width:{{#hasItemCode itemdetails}}43{{else}}56{{/hasItemCode}}%">
      <col style="width:7%">
      <col style="width:8%">
      <col style="width:12%">
      <col style="width:13%">
    </colgroup>
    <thead>
      <tr>
        <th>
          <span class="head-ar">م</span>
          <span class="head-en">S.N</span>
        </th>
        {{#hasItemCode itemdetails}}
        <th>
          <span class="head-ar">رمز الصنف</span>
          <span class="head-en">Part Number</span>
        </th>
        {{/hasItemCode}}
        <th>
          <span class="head-ar">الوصف</span>
          <span class="head-en">Description</span>
        </th>
        <th>
          <span class="head-ar">الوحدة</span>
          <span class="head-en">UOM</span>
        </th>
        <th>
          <span class="head-ar">الكمية</span>
          <span class="head-en">QTY</span>
        </th>
        <th>
          <span class="head-ar">سعر الوحدة</span>
          <span class="head-en">Unit Price</span>
        </th>
        <th>
          <span class="head-ar"> الإجمالي</span>
          <span class="head-en">Total Amount</span>
        </th>
      </tr>
    </thead>
    <tbody>
      {{#each itemdetails}}
      <tr>
        <td class="center">{{addOne @index}}</td>
        {{#hasItemCode ../itemdetails}}
        <td class="center">{{part_number}}</td>
        {{/hasItemCode}}
        <td class="left">
          {{item_name}}{{#if name_lang2}}{{name_lang2}}{{/if}}{{#if description}}{{description}}{{/if}}
        </td>
        <td class="center">{{unit}}</td>
        <td class="center">{{formatAmount quantity 0}}</td>
        <td class="right">{{formatAmount price ../bcdp}}</td>
        <td class="right">{{formatAmount amount ../bcdp}}</td>
      </tr>
      {{/each}}
      <tr class="item-spacer" style="height: 390px;">
        <td></td><td></td><td></td><td></td><td></td><td></td><td></td>
      </tr>
    </tbody>
  </table>

  <div class="footer-block">

  <!-- Totals -->
  <table class="totals-wrap">
    <colgroup>
      <col style="width:45%">
      <col style="width:15%">
      <col style="width:15%">
      <col style="width:25%">
    </colgroup>
    <tr>
      <td class="t-lbl" style="border-right: none !important;"></td>
      <td class="t-lbl" style="border-left: none !important;border-right: none !important;">Total</td>
      <td class="t-ar" style="border-left: none !important;">الإجمالي</td>
      <td class="t-val">{{formatAmount (divide basicdetails.[0].subtotal ccrate) bcdp}}</td>
    </tr>
    <tr>
      <td class="t-lbl" style="border-right: none !important;"></td>
      <td class="t-lbl" style="border-left: none !important;border-right: none !important;">Discount</td>
      <td class="t-ar" style="border-left: none !important;">الخصم</td>
      <td class="t-val">{{formatAmount (divide (add basicdetails.[0].discount basicdetails.[0].dld) ccrate) bcdp}}</td>
    </tr>
    <tr>
      <td class="t-lbl" style="border-right: none !important;"></td>
      <td class="t-lbl" style="border-left: none !important;border-right: none !important;">Net Amount</td>
      <td class="t-ar" style="border-left: none !important;">المبلغ الصافي</td>
      {{!-- subtotal - discount + dld --}}
      <td class="t-val">{{formatAmount (divide (subtract basicdetails.[0].subtotal (add basicdetails.[0].discount basicdetails.[0].dld)) ccrate) bcdp}}</td>
    </tr>
    <tr>
      <td class="t-lbl" style="border-right: none !important;"></td>
      <td class="t-lbl" style="border-left: none !important;border-right: none !important;">VAT</td>
      <td class="t-ar" style="border-left: none !important;">ضريبة</td>
      <td class="t-val">{{formatAmount (divide basicdetails.[0].vatamt ccrate) bcdp}}</td>
    </tr>
    <tr>
      <td class="t-lbl" style="border-right: none !important;"></td>
      <td class="t-lbl" style="border-left: none !important;border-right: none !important;">TOTAL AMOUNT</td>
      <td class="t-ar" style="border-left: none !important;">المبلغ الإجمالي</td>
      <td class="t-val">{{formatAmount (divide basicdetails.[0].grand_total ccrate) bcdp}}</td>
    </tr>
  </table>

  <!-- Bottom: Terms | Bank Details -->
  <table class="bottom-wrap">
    <colgroup>
      <col style="width:50%">
      <col style="width:50%">
    </colgroup>
    <tr>
      <td>
        <div class="terms-title">Terms and Condition</div>
        <div class="terms-text">{{#if basicdetails.[0].terms_and_condition}}{{{nl2br basicdetails.[0].terms_and_condition}}}{{else}}{{#if invterms}}{{{nl2br invterms}}}{{/if}}{{/if}}</div>
      </td>
      <td class="bank-block">
        <div class="bank-head">Bank Details</div>
        <table class="bank-detail-table">
            <colgroup>
                <col style="width:19%">
                <col style="width:3%">
                <col style="width:78%">
            </colgroup>
          <tr><td class="bd-lbl">Bank Name</td><td class="bd-sep">:</td><td class="bd-val">{{bankdetails.name}}</td></tr>
          <tr><td class="bd-lbl">A/c Name</td><td class="bd-sep">:</td><td class="bd-val">{{bankdetails.acc_name}}</td></tr>
          <tr><td class="bd-lbl">A/c No</td><td class="bd-sep">:</td><td class="bd-val">{{bankdetails.acc_no}}</td></tr>
          <tr><td class="bd-lbl">IBAN</td><td class="bd-sep">:</td><td class="bd-val">{{bankdetails.iban_no}}</td></tr>
          <tr><td class="bd-lbl">SWIFT</td><td class="bd-sep">:</td><td class="bd-val">{{bankdetails.swift_no}}</td></tr>
        </table>
      </td>
    </tr>
  </table>

  </div>

</div>

</body>
</html>
