<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Purchase Order - {{basicdetails.[0].inv_no}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: ibmplexsansarabic;
      font-size: 10.5px;
      color: #000;
      background: #fff;
      margin: 0 6mm;
      /* fill the printable page height so the totals / signature block always
         sits at the bottom — the gap below terms absorbs whatever is left over */
      display: flex;
      flex-direction: column;
      min-height: calc(99vh - {{#if FooterImageUrl}}max(45px, {{default datasettings.d75 '45'}}px){{else}}0px{{/if}});
    }
    body > * { flex: 0 0 auto; }
    table { border-collapse: collapse; width: 100%; table-layout: fixed; }
    .b { font-weight: bold; }

    .doc-title {
      text-align: center;
      color: #2e3e57;
      font-weight: bold;
      font-size: 17.5px;
      padding-bottom: 8px;
    }

    /* outer frame */
    .frame { border: 2px solid #000; flex: 1 0 auto; display: flex; flex-direction: column; }
    .frame > * { flex: 0 0 auto; }
    .frame > .fill { flex: 1 0 auto; }
    .bottom-block { page-break-inside: avoid; break-inside: avoid; }

    /* ── top: company | PO no + date + vendor ── */
    .top > tbody > tr > td { vertical-align: top; }
    .top .co { border-right: 1px solid #000; padding: 0; }
    .top .rhs { padding: 0; }
    .meta { text-align: center; padding: 8px 6px; border-bottom: 1px solid #000; line-height: 1.5; }
    .vend { padding: 10px 12px 0; font-weight: 700; }
    .vend-vat { padding: 6px 12px 10px; line-height: 1.5; }

    /* ── items ── */
    .items th, .items td { border: 1px solid #000; padding: 3px 5px; font-size: 10.5px; vertical-align: top; }
    .items tr > :first-child { border-left: none; }
    .items tr > :last-child  { border-right: none; }
    .items th { font-weight: bold; text-align: center; white-space: nowrap; padding: 6px 3px;  }
    .items th.l, .items td.l { text-align: left; }
    .items th.c, .items td.c { text-align: center; }
    .items td { text-align: right; }
    .items tr { page-break-inside: avoid; }

    /* ── terms ── */
    .terms {padding: 6px 6px 8px; }
    .terms .th { font-weight: bold; text-align: left;vertical-align: top;}

    /* ── totals ── */
    .tot { border-top: 1px solid #000; }
    .tot td { padding: 2px 6px; line-height: 1.6; }
    .tot .tl { font-weight: bold; text-align: right; padding-right: 30px; }
    .tot .tv { text-align: right; }
    {{!-- .tot .last td { border-bottom: 1px solid #000; } --}}

    /* ── seal / signature ── */
    .seal td { text-align: center;vertical-align: top; height: 40px; padding: 6px; }
    .seal .lhs { border-right: 1px solid #000;border-top: 2px dashed #000; }
    .seal .rhs { border-top: 2px dashed #000; text-align: center; position: relative; padding-top: 6px; }
    .seal .auth { font-size: 10px; margin-top: 14px; }
  </style>
</head>
<body>

  <div class="doc-title">Purchase Order</div>

  <div class="frame">

    <!-- TOP -->
    <table class="top">
      <colgroup><col style="width:50%"><col style="width:50%"></colgroup>
      
      <tr>
        <td class="co">
          <div class="meta"><span class="b">Purchase Order Number</span><br>{{basicdetails.[0].inv_no}}</div>
          <div class="vend">{{branch.[0].name}}</div>
          <div class="vend-vat">
          {{#if branch.[0].address_line1}}<div>{{branch.[0].address_line1}}</div>{{/if}}
          {{#if branch.[0].address_line2}}<div>{{branch.[0].address_line2}}</div>{{/if}}
          {{#if branch.[0].address_line3}}<div>{{branch.[0].address_line3}}</div>{{/if}}
          {{#if branch.[0].address_line4}}<div>{{branch.[0].address_line4}}</div>{{/if}}
          {{#if branch.[0].address_line5}}<div>{{branch.[0].address_line5}}</div>{{/if}}
          {{#if branch.[0].address_code}}<div>{{branch.[0].address_code}}</div>{{/if}}
          {{#if branch.[0].vat}}<div>{{branch.[0].vat}}</div>{{/if}}
          </div>
        </td>
        <td class="rhs">
          <div class="meta"><span class="b">Date</span><br>{{basicdetails.[0].inv_date}}</div>
          <div class="vend">{{#if vendor_details.[0].name}}{{vendor_details.[0].name}}{{else}}{{billing_address.[0].name}}{{/if}}</div>
          <div class="vend-vat">
            {{#if vendor_details.[0].address_line1}}<div>{{vendor_details.[0].address_line1}}</div>{{/if}}
            {{#if vendor_details.[0].address_line2}}<div>{{vendor_details.[0].address_line2}}</div>{{/if}}
            {{#if vendor_details.[0].address_line3}}<div>{{vendor_details.[0].address_line3}}</div>{{/if}}
            {{#if vendor_details.[0].address_line4}}<div>{{vendor_details.[0].address_line4}}</div>{{/if}}
            {{#if vendor_details.[0].address_line5}}<div>{{vendor_details.[0].address_line5}}</div>{{/if}}
            {{#if vendor_details.[0].address_code}}<div>{{vendor_details.[0].address_code}}</div>{{/if}}
            {{#if vendor_details.[0].vat}}<div>{{vendor_details.[0].vat}}</div>{{/if}}
          </div>
        </td>
      </tr>
    </table>

    <!-- ITEMS -->
    <div class="items-wrap">
      <table class="items">
        <colgroup>
          <col style="width:4%">
          <col style="width:30%">
          <col style="width:9%">
          <col style="width:7%">
          <col style="width:10%">
          <col style="width:11%">
          <col style="width:8%">
          <col style="width:10%">
          <col style="width:11%">
        </colgroup>
        <thead>
          <tr>
            <th>#</th>
            <th>Description</th>
            <th>Quantity</th>
            <th>Unit</th>
            <th>Unit Price</th>
            <th class="c">Taxable</th>
            <th class="c">Tax Rate</th>
            <th>Tax Amount</th>
            <th class="c">Item Subtotal</th>
          </tr>
        </thead>
        <tbody>
          {{#each itemdetails}}
          <tr>
            <td class="c">{{addOne @index}}</td>
            <td class="l">{{item_name}}{{#if name_lang2}}<div>{{name_lang2}}</div>{{/if}}{{#if description}}<div>{{description}}</div>{{/if}}</td>
            <td style="text-align: center;">{{quantity}}</td>
            <td style="text-align: center;">{{unit}}</td>
            <td>{{formatAmount (divide price ../ccrate) ../bcdp}}</td>
            <td>{{formatAmount (divide taxable ../ccrate) ../bcdp}}</td>
            <td style="text-align: center;">{{vat_perc}}</td>
            <td>{{formatAmount (divide tax ../ccrate) ../bcdp}}</td>
            <td>{{formatAmount (divide amount ../ccrate) ../bcdp}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- TERMS -->
    <div class="terms">
      {{#if basicdetails.[0].terms_and_condition}}
      <div class="th">Terms And Conditions</div>
      <div>{{{nl2br basicdetails.[0].terms_and_condition}}}</div>{{/if}}
    </div>

    <div class="fill"></div>

    <div class="bottom-block">
    <!-- TOTALS -->
    <table class="tot">
      <colgroup><col style="width:50%"><col style="width:38%"><col style="width:12%"></colgroup>
      <tr>
        <td class="b">Amount chargeable in words</td>
        <td class="tl">Total (Excluding VAT )</td>
        <td class="tv">{{formatAmount (divide basicdetails.[0].subtotal ccrate) bcdp}}</td>
      </tr>
      <tr>
        <td>{{bcamountinwords}}</td>
        <td class="tl">VAT</td>
        <td class="tv">{{formatAmount (divide basicdetails.[0].vatamt ccrate) bcdp}}</td>
      </tr>
      <tr>
        <td class="b">{{#if vatamountinwords}}VAT Amount in words{{/if}}</td>
        <td class="tl" rowspan="2" style="vertical-align: top;">Grand Total</td>
        <td class="tv" rowspan="2" style="vertical-align: top;">{{formatAmount (divide basicdetails.[0].grand_total ccrate) bcdp}}</td>
      </tr>
      <tr class="last">
        <td>{{#if vatamountinwords}}{{vatamountinwords}}{{/if}}</td>
      </tr>
    </table>

    <!-- SEAL / SIGNATURE -->
    <table class="seal">
      <colgroup><col style="width:50%"><col style="width:50%"></colgroup>
      <tr>
        <td class="lhs b">Seal and Signature</td>
        <td class="rhs">
          <div>For {{branch.[0].name}}</div>
          {{#if Seal}}<div><img src="{{Seal}}" alt="Seal" style="text-align:center;max-height:{{ datasettings.d458 }}px; max-width:{{ datasettings.d458}}px;" onerror="this.style.display='none'"/></div>{{/if}}
          <div class="auth b">Authorised Signatory</div>
        </td>
      </tr>
    </table>
    </div>

  </div>

</body>
</html>
